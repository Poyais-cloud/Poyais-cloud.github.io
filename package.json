{
  "name": "my-blog",
  "private": true,
  "scripts": {
    "build": "hexo clean && hexo generate",
    "preview": "npm run build && http-server public -p 4000",
    "deploy": "npm run build && hexo deploy",
    "posts": "find source/_posts -maxdepth 1 -type f -name '*.md' | sort",
    "drafts": "find source/_drafts -maxdepth 1 -type f -name '*.md' | sort",
    "import:obsidian": "node tools/import-obsidian-post.mjs"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-cli": "^4.3.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.5.3"
  },
  "hexo": {
    "version": "8.1.2"
  }
}
